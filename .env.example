SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
PUSHOVER_APP_TOKEN=replace_with_pushover_application_token
PUSHOVER_USER_KEY=replace_with_pushover_user_key

# Indicator settings
EMA_LENGTH=50
PIVOT_LENGTH=5
STORED_LEVELS=20
ATR_LENGTH=14
MIN_SWEEP_DISTANCE_ATR=0.10
MIN_WICK_PERCENT=0.35
MAX_BODY_PERCENT=0.65
MIN_CANDLE_RANGE_ATR=0.20
CONFIRMATION_WINDOW=2
SIGNAL_COOLDOWN_BARS=10
STOP_LOSS_ATR_MULTIPLIER=1.5
TAKE_PROFIT_RR=3
USE_EMA_FILTER=true
REQUIRE_MIDLINE_BREAK=true
REQUIRE_BULLISH_BODY=true
REQUIRE_BEARISH_BODY=true

POLL_SECONDS=60
KLINE_LIMIT=500
STATE_FILE=/opt/binance-liquidity-alert/state.json
LOG_LEVEL=INFO
