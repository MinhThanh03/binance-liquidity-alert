[Unit]
Description=Binance 1H Liquidity Pushover Alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/binance-liquidity-alert
ExecStart=/opt/binance-liquidity-alert/.venv/bin/python /opt/binance-liquidity-alert/liquidity_alert.py
EnvironmentFile=/opt/binance-liquidity-alert/.env
Restart=always
RestartSec=15
User=binance-alert
Group=binance-alert
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
